@page
@model EComLite.Web.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Cart";
}

<style>
    .cart-root {
        font-family: 'Inter', sans-serif;
        background: #fafafa;
        min-height: calc(100vh - 60px);
    }

    /* ── Page header ── */
    .page-header {
        background: #ffffff;
        border-bottom: 1px solid #f0f0f5;
        padding: 40px 0 32px;
    }

    .page-header-inner {
        max-width: 1040px;
        margin: 0 auto;
        padding: 0 28px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .page-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #6366f1;
        margin-bottom: 6px;
    }

    .page-header-inner h1 {
        font-family: 'Outfit', sans-serif;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.025em;
        color: #0f0f1a;
        margin: 0;
        line-height: 1.15;
    }

    .cart-count-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 12px;
        font-weight: 500;
        padding: 5px 12px;
        border-radius: 99px;
        border: 1px solid #c7d2fe;
        white-space: nowrap;
    }

    /* ── Body ── */
    .cart-body {
        max-width: 1040px;
        margin: 0 auto;
        padding: 32px 28px 72px;
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 24px;
        align-items: start;
    }

    /* ── Alert ── */
    .alert-info-custom {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 14px;
        color: #1d4ed8;
        margin-bottom: 20px;
        grid-column: 1 / -1;
    }

    /* ── Cart items card ── */
    .cart-card {
        background: #ffffff;
        border: 1px solid #e9eaee;
        border-radius: 16px;
        overflow: hidden;
    }

    .cart-table {
        width: 100%;
        border-collapse: collapse;
    }

        .cart-table thead tr {
            border-bottom: 1px solid #f0f0f5;
        }

        .cart-table thead th {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #9ca3af;
            padding: 14px 20px;
            text-align: left;
            background: #fafafa;
            white-space: nowrap;
        }

            .cart-table thead th.th-right {
                text-align: right;
            }

        .cart-table tbody tr {
            border-bottom: 1px solid #f7f7f9;
            transition: background 0.15s;
            opacity: 0;
            animation: rowIn 0.35s ease forwards;
        }

            .cart-table tbody tr:nth-child(1) {
                animation-delay: 0.05s;
            }

            .cart-table tbody tr:nth-child(2) {
                animation-delay: 0.10s;
            }

            .cart-table tbody tr:nth-child(3) {
                animation-delay: 0.15s;
            }

            .cart-table tbody tr:nth-child(4) {
                animation-delay: 0.20s;
            }

            .cart-table tbody tr:nth-child(5) {
                animation-delay: 0.25s;
            }

            .cart-table tbody tr:last-child {
                border-bottom: none;
            }

            .cart-table tbody tr:hover {
                background: #fafbff;
            }

    @@keyframes rowIn {
        to {
            opacity: 1;
        }
    }

    .cart-table tbody td {
        padding: 18px 20px;
        font-size: 14px;
        color: #374151;
        vertical-align: middle;
    }

    /* Product name cell */
    .td-product {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .product-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #eef2ff, #f5f3ff);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #e0e7ff;
    }

    .product-name {
        font-family: 'Outfit', sans-serif;
        font-size: 15px;
        font-weight: 600;
        color: #0f0f1a;
        letter-spacing: -0.01em;
    }

    /* Price cells */
    .td-price {
        font-size: 14px;
        color: #6b7280;
        white-space: nowrap;
    }

    .td-qty .qty-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 26px;
        padding: 0 10px;
        background: #f3f4f6;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        font-family: 'Outfit', sans-serif;
    }

    .td-total {
        font-family: 'Outfit', sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: #0f0f1a;
        text-align: right;
        letter-spacing: -0.01em;
        white-space: nowrap;
    }

    /* Remove button */
    .btn-remove {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: none;
        border: 1px solid #fee2e2;
        color: #dc2626;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        padding: 5px 10px;
        border-radius: 7px;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }

        .btn-remove:hover {
            background: #fff1f2;
            border-color: #fca5a5;
        }

    /* ── Summary card ── */
    .summary-card {
        background: #ffffff;
        border: 1px solid #e9eaee;
        border-radius: 16px;
        padding: 24px;
        position: sticky;
        top: 24px;
        opacity: 0;
        transform: translateY(12px);
        animation: fadeUp 0.45s ease forwards 0.2s;
    }

    @@keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .summary-title {
        font-family: 'Outfit', sans-serif;
        font-size: 16px;
        font-weight: 600;
        color: #0f0f1a;
        margin-bottom: 20px;
        letter-spacing: -0.01em;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 12px;
    }

        .summary-row.total-row {
            border-top: 1px solid #f0f0f5;
            padding-top: 16px;
            margin-top: 4px;
            margin-bottom: 20px;
        }

            .summary-row.total-row span:first-child {
                font-size: 15px;
                font-weight: 600;
                color: #0f0f1a;
            }

    .summary-total-value {
        font-family: 'Outfit', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: #0f0f1a;
        letter-spacing: -0.03em;
    }

    /* Checkout button */
    .btn-checkout {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #6366f1;
        color: #fff;
        font-family: 'Inter', sans-serif;
        font-size: 15px;
        font-weight: 500;
        padding: 13px;
        border-radius: 11px;
        border: none;
        cursor: pointer;
        width: 100%;
        transition: background 0.18s, transform 0.15s, box-shadow 0.18s;
        box-shadow: 0 1px 3px rgba(99,102,241,0.25), 0 4px 14px rgba(99,102,241,0.18);
        margin-bottom: 10px;
    }

        .btn-checkout:hover {
            background: #4f46e5;
            transform: translateY(-1px);
            box-shadow: 0 2px 6px rgba(99,102,241,0.3), 0 8px 20px rgba(99,102,241,0.22);
        }

    /* Clear cart button */
    .btn-clear {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: none;
        color: #9ca3af;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 500;
        padding: 9px;
        border-radius: 9px;
        border: 1px solid #e5e7eb;
        cursor: pointer;
        width: 100%;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
    }

        .btn-clear:hover {
            background: #fff1f2;
            color: #dc2626;
            border-color: #fca5a5;
        }

    /* secure note */
    .secure-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        margin-top: 14px;
        font-size: 12px;
        color: #9ca3af;
    }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 80px 24px;
        grid-column: 1 / -1;
    }

    .empty-icon {
        width: 56px;
        height: 56px;
        background: #eef2ff;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .empty-state h3 {
        font-family: 'Outfit', sans-serif;
        font-size: 20px;
        font-weight: 600;
        color: #0f0f1a;
        margin-bottom: 8px;
    }

    .empty-state p {
        font-size: 14px;
        color: #9ca3af;
        margin-bottom: 24px;
    }

    .btn-browse {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #6366f1;
        color: #fff !important;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 500;
        padding: 10px 20px;
        border-radius: 9px;
        text-decoration: none;
        transition: background 0.18s, transform 0.15s;
    }

        .btn-browse:hover {
            background: #4f46e5;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .cart-body {
            grid-template-columns: 1fr;
            padding: 20px 14px 48px;
        }

        .summary-card {
            position: static;
        }

        .page-header-inner {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="cart-root">

    <!-- ── Page header ── -->
    <div class="page-header">
        <div class="page-header-inner">
            <div>
                <div class="page-label">Shopping</div>
                <h1>Your Cart</h1>
            </div>
            @if (Model.Items.Any())
            {
                <div class="cart-count-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6" /></svg>
                    @Model.Items.Count item@(Model.Items.Count == 1 ? "" : "s") in cart
                </div>
            }
        </div>
    </div>

    <div class="cart-body">

        @if (TempData["Message"] != null)
        {
            <div class="alert-info-custom">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                @TempData["Message"]
            </div>
        }

        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6" /></svg>
                </div>
                <h3>Your cart is empty</h3>
                <p>Add some products to get started.</p>
                <a asp-page="/Products/Index" class="btn-browse">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z" /><path d="M16 3H8l-2 4h12l-2-4z" /></svg>
                    Browse products
                </a>
            </div>
        }
        else
        {
            <!-- Left: items table -->
            <div class="cart-card">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Unit price</th>
                            <th>Qty</th>
                            <th class="th-right">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="td-product">
                                        <div class="product-icon-box">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z" />
                                                <path d="M16 3H8l-2 4h12l-2-4z" />
                                            </svg>
                                        </div>
                                        <span class="product-name">@item.ProductName</span>
                                    </div>
                                </td>
                                <td class="td-price">@item.UnitPrice.ToString("C")</td>
                                <td class="td-qty">
                                    <span class="qty-pill">@item.Qty</span>
                                </td>
                                <td class="td-total">@((item.Qty * item.UnitPrice).ToString("C"))</td>
                                <td>
                                    <form method="post" asp-page-handler="Remove" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn-remove">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6M14 11v6" /></svg>
                                            Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Right: summary card -->
            <div class="summary-card">
                <div class="summary-title">Order summary</div>

                @foreach (var item in Model.Items)
                {
                    <div class="summary-row">
                        <span>@item.ProductName × @item.Qty</span>
                        <span>@((item.Qty * item.UnitPrice).ToString("C"))</span>
                    </div>
                }

                <div class="summary-row total-row">
                    <span>Total</span>
                    <span class="summary-total-value">@Model.Total.ToString("C")</span>
                </div>

                <form method="post" asp-page-handler="Checkout">
                    <button type="submit" class="btn-checkout">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" /></svg>
                        Place Order
                    </button>
                </form>

                <form method="post" asp-page-handler="Clear">
                    <button type="submit" class="btn-clear">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14H6L5 6" /></svg>
                        Clear cart
                    </button>
                </form>

                <div class="secure-note">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Atomic checkout — all or nothing
                </div>
            </div>
        }

    </div>
</div>
