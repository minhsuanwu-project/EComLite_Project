@page
@model EComLite.Web.Pages.Admin.OrdersModel
@{
    ViewData["Title"] = "Admin · Order Management";
}

<style>
    .admin-root {
        font-family: 'Inter', sans-serif;
        background: #fafafa;
        min-height: calc(100vh - 60px);
    }

    .admin-header {
        background: #ffffff;
        border-bottom: 1px solid #f0f0f5;
        padding: 40px 0 32px;
    }

    .admin-header-inner {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 28px;
    }

    .admin-eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #6366f1;
        margin-bottom: 6px;
    }

    .admin-title {
        font-size: 28px;
        font-weight: 600;
        color: #18181b;
        margin: 0;
    }

    .admin-subtitle {
        font-size: 14px;
        color: #71717a;
        margin-top: 6px;
    }

    .admin-body {
        max-width: 1140px;
        margin: 0 auto;
        padding: 28px;
    }

    .alert-bar {
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .alert-ok {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .alert-err {
        background: #fff1f2;
        color: #be123c;
        border: 1px solid #fecdd3;
    }

    .admin-card {
        background: #fff;
        border: 1px solid #f0f0f5;
        border-radius: 14px;
        overflow: hidden;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

    .admin-table th {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #a1a1aa;
        padding: 14px 18px;
        border-bottom: 1px solid #f0f0f5;
        white-space: nowrap;
    }

    .admin-table td {
        padding: 16px 18px;
        border-bottom: 1px solid #f7f7f9;
        font-size: 14px;
        color: #27272a;
        vertical-align: middle;
    }

    .admin-table tr:last-child td {
        border-bottom: none;
    }

    .mono {
        font-variant-numeric: tabular-nums;
        font-weight: 500;
    }

    .cust {
        color: #52525b;
        font-size: 13px;
    }

    .td-date {
        color: #6b7280;
        font-size: 13px;
        white-space: nowrap;
    }

    .qty-pill {
        display: inline-block;
        min-width: 24px;
        text-align: center;
        background: #f4f4f5;
        border-radius: 6px;
        padding: 2px 7px;
        font-size: 13px;
        color: #3f3f46;
    }

    /* Status badges — same lifecycle vocabulary as the customer order page */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 500;
        padding: 4px 10px;
        border-radius: 99px;
        white-space: nowrap;
    }

    .status-badge-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
    }

    .status-pending { background:#fffbeb; color:#b45309; border:1px solid #fde68a; }
    .status-pending .status-badge-dot { background:#f59e0b; }

    .status-processing { background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; }
    .status-processing .status-badge-dot { background:#3b82f6; }

    .status-shipped { background:#eef2ff; color:#4338ca; border:1px solid #c7d2fe; }
    .status-shipped .status-badge-dot { background:#6366f1; }

    .status-delivered { background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; }
    .status-delivered .status-badge-dot { background:#22c55e; }

    .status-placed { background:#f4f4f5; color:#52525b; border:1px solid #e4e4e7; }
    .status-placed .status-badge-dot { background:#a1a1aa; }

    .advance-btn {
        border: none;
        background: #18181b;
        color: #fff;
        font-size: 13px;
        font-weight: 500;
        padding: 7px 14px;
        border-radius: 8px;
        cursor: pointer;
        white-space: nowrap;
    }

    .advance-btn:hover { background: #3f3f46; }

    .terminal-note {
        font-size: 13px;
        color: #a1a1aa;
    }

    .empty-state {
        text-align: center;
        padding: 72px 24px;
        color: #71717a;
    }
</style>

@functions {
    static string StatusClass(string? s) => s?.ToLower() switch
    {
        "pending" => "status-pending",
        "processing" => "status-processing",
        "shipped" => "status-shipped",
        "delivered" => "status-delivered",
        _ => "status-placed"
    };
}

<div class="admin-root">
    <div class="admin-header">
        <div class="admin-header-inner">
            <div class="admin-eyebrow">Admin</div>
            <h1 class="admin-title">Order Management</h1>
            <div class="admin-subtitle">
                All customer orders. Status may only advance one step along
                Pending &rarr; Processing &rarr; Shipped &rarr; Delivered.
            </div>
        </div>
    </div>

    <div class="admin-body">
        @if (TempData["Message"] != null)
        {
            <div class="alert-bar alert-ok">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert-bar alert-err">@TempData["Error"]</div>
        }

        @if (!Model.Orders.Any())
        {
            <div class="admin-card">
                <div class="empty-state">No orders have been placed yet.</div>
            </div>
        }
        else
        {
            <div class="admin-card">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Qty</th>
                            <th style="text-align:right;">Total</th>
                            <th>Placed at</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Orders)
                        {
                            <tr>
                                <td class="mono">@o.OrderNumber</td>
                                <td class="cust">@o.CustomerEmail</td>
                                <td><span class="qty-pill">@o.TotalQty</span></td>
                                <td class="mono" style="text-align:right;">@o.TotalAmount.ToString("C")</td>
                                <td class="td-date">@o.PlacedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</td>
                                <td>
                                    <span class="status-badge @StatusClass(o.Status)">
                                        <span class="status-badge-dot"></span>
                                        @o.Status
                                    </span>
                                </td>
                                <td>
                                    @if (o.NextStatus != null)
                                    {
                                        <form method="post" asp-page-handler="Advance" style="margin:0;">
                                            <input type="hidden" name="orderId" value="@o.OrderId" />
                                            <input type="hidden" name="newStatus" value="@o.NextStatus" />
                                            <button type="submit" class="advance-btn">
                                                Mark @o.NextStatus
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="terminal-note">Complete</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
