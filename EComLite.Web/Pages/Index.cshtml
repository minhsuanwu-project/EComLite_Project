@page
@model IndexModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    ViewData["Title"] = "Home";
}

<style>

    .home-root {
        font-family: 'Inter', sans-serif;
        color: #1a1a2e;
    }

    /* ── Hero ── */
    .hero {
        position: relative;
        padding: 96px 0 80px;
        text-align: center;
        overflow: hidden;
        background: #ffffff;
    }

    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 80% 60% at 50% -10%, #e8f0fe 0%, transparent 70%),
            radial-gradient(ellipse 50% 40% at 85% 60%, #ede9fe 0%, transparent 60%);
        z-index: 0;
    }

    .hero-grid-bg {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(99,102,241,0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(99,102,241,0.05) 1px, transparent 1px);
        background-size: 48px 48px;
        z-index: 0;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 720px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.04em;
        padding: 5px 14px;
        border-radius: 99px;
        border: 1px solid #c7d2fe;
        margin-bottom: 28px;
        font-family: 'Inter', sans-serif;
    }

    .hero-badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6366f1;
        animation: pulse-dot 2s ease-in-out infinite;
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.5; transform: scale(0.7); }
    }

    .hero-title {
        font-family: 'Outfit', sans-serif;
        font-size: clamp(38px, 6vw, 60px);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.03em;
        color: #0f0f1a;
        margin-bottom: 20px;
        opacity: 0;
        transform: translateY(18px);
        animation: fadeUp 0.55s ease forwards 0.1s;
    }

    .hero-title span {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-sub {
        font-size: 18px;
        color: #52526e;
        line-height: 1.65;
        max-width: 520px;
        margin: 0 auto 36px;
        font-weight: 400;
        opacity: 0;
        transform: translateY(18px);
        animation: fadeUp 0.55s ease forwards 0.22s;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
        opacity: 0;
        transform: translateY(18px);
        animation: fadeUp 0.55s ease forwards 0.34s;
    }

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #6366f1;
        color: #fff !important;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 500;
        padding: 11px 24px;
        border-radius: 10px;
        text-decoration: none;
        border: none;
        transition: background 0.18s, transform 0.15s, box-shadow 0.18s;
        box-shadow: 0 1px 3px rgba(99,102,241,0.25), 0 4px 14px rgba(99,102,241,0.18);
    }

    .btn-primary-custom:hover {
        background: #4f46e5;
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(99,102,241,0.3), 0 8px 20px rgba(99,102,241,0.22);
    }

    .btn-secondary-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        color: #374151 !important;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 500;
        padding: 11px 24px;
        border-radius: 10px;
        text-decoration: none;
        border: 1px solid #e5e7eb;
        transition: background 0.18s, transform 0.15s, border-color 0.18s;
    }

    .btn-secondary-custom:hover {
        background: #f9fafb;
        border-color: #d1d5db;
        transform: translateY(-1px);
    }

    .hero-user-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 32px;
        font-size: 13px;
        color: #6b7280;
        opacity: 0;
        animation: fadeUp 0.5s ease forwards 0.46s;
    }

    .user-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 600;
        color: #fff;
    }

    /* ── Divider ── */
    .section-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, #e5e7eb 20%, #e5e7eb 80%, transparent);
        margin: 0 40px;
    }

    /* ── Features section ── */
    .features-section {
        padding: 72px 0 80px;
        background: #fafafa;
    }

    .section-header {
        text-align: center;
        margin-bottom: 48px;
        padding: 0 24px;
    }

    .section-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #6366f1;
        margin-bottom: 10px;
        font-family: 'Inter', sans-serif;
    }

    .section-title {
        font-family: 'Outfit', sans-serif;
        font-size: clamp(24px, 4vw, 32px);
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #0f0f1a;
        margin-bottom: 10px;
    }

    .section-sub {
        font-size: 15px;
        color: #6b7280;
        max-width: 440px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* ── Feature cards ── */
    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        max-width: 960px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .feature-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 28px 26px;
        transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
        position: relative;
        overflow: hidden;
    }

    .feature-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        border-radius: 14px 14px 0 0;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .feature-card:hover {
        border-color: #c7d2fe;
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(99,102,241,0.10);
    }

    .feature-card:hover::before { opacity: 1; }

    .card-catalog::before  { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
    .card-cart::before     { background: linear-gradient(90deg, #06b6d4, #6366f1); }
    .card-orders::before   { background: linear-gradient(90deg, #8b5cf6, #ec4899); }

    .card-icon-wrap {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

    .icon-catalog { background: #eef2ff; }
    .icon-cart    { background: #ecfeff; }
    .icon-orders  { background: #faf5ff; }

    .card-icon-wrap svg { width: 20px; height: 20px; }

    .feature-card h3 {
        font-family: 'Outfit', sans-serif;
        font-size: 16px;
        font-weight: 600;
        color: #0f0f1a;
        margin-bottom: 8px;
        letter-spacing: -0.01em;
    }

    .feature-card p {
        font-size: 14px;
        color: #6b7280;
        line-height: 1.6;
        margin: 0;
    }

    /* ── Stats strip ── */
    .stats-strip {
        background: #fff;
        border-top: 1px solid #f3f4f6;
        border-bottom: 1px solid #f3f4f6;
        padding: 32px 24px;
    }

    .stats-inner {
        max-width: 720px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        gap: 0;
        flex-wrap: wrap;
    }

    .stat-item {
        flex: 1;
        min-width: 140px;
        text-align: center;
        padding: 0 24px;
        border-right: 1px solid #f3f4f6;
    }

    .stat-item:last-child { border-right: none; }

    .stat-value {
        font-family: 'Outfit', sans-serif;
        font-size: 26px;
        font-weight: 700;
        color: #0f0f1a;
        letter-spacing: -0.03em;
        line-height: 1;
        margin-bottom: 4px;
    }

    .stat-value span { color: #6366f1; }

    .stat-label {
        font-size: 12px;
        color: #9ca3af;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    @@keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 576px) {
        .stats-inner { flex-direction: column; gap: 24px; }
        .stat-item { border-right: none; border-bottom: 1px solid #f3f4f6; padding-bottom: 24px; }
        .stat-item:last-child { border-bottom: none; }
    }
</style>

<div class="home-root">

    <!-- ── Hero ── -->
    <section class="hero">
        <div class="hero-grid-bg"></div>
        <div class="hero-inner">

            <div class="hero-badge">
                <span class="hero-badge-dot"></span>
                CISC 594 · Project
            </div>

            <h1 class="hero-title">
                Reliable ordering,<br><span>built to prove it</span>
            </h1>

            <p class="hero-sub">
                A self-hosted lightweight ordering platform for small organizations —
                authenticated, transactionally correct, and deployable from scratch in under 30 minutes.
            </p>

            <div class="hero-actions">
                <a asp-page="/Products/Index" class="btn-primary-custom">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                    Browse Products
                </a>
                <a asp-page="/Orders/Index" class="btn-secondary-custom">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                    View My Orders
                </a>
            </div>

            @if (SignInManager.IsSignedIn(User))
            {
                <div class="hero-user-chip">
                    <div class="user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    Signed in as <strong style="color:#374151; margin-left:2px;">@User.Identity?.Name</strong>
                </div>
            }

        </div>
    </section>

    <!-- ── Stats strip ── -->
    <div class="stats-strip">
        <div class="stats-inner">
            <div class="stat-item">
                <div class="stat-value"><span>≥</span> 95%</div>
                <div class="stat-label">Checkout success rate</div>
            </div>
            <div class="stat-item">
                <div class="stat-value"><span>100</span>%</div>
                <div class="stat-label">Data consistency</div>
            </div>
            <div class="stat-item">
                <div class="stat-value"><span>&lt;</span> 30<span style="font-size:14px;"> min</span></div>
                <div class="stat-label">Setup from scratch</div>
            </div>
        </div>
    </div>

    <!-- ── Features ── -->
    <section class="features-section">
        <div class="section-header">
            <div class="section-label">What's inside</div>
            <h2 class="section-title">End-to-end ordering, fully covered</h2>
            <p class="section-sub">Every feature is tested, logged, and verified against measurable success criteria.</p>
        </div>

        <div class="feature-grid">
            <div class="feature-card card-catalog">
                <div class="card-icon-wrap icon-catalog">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 3H8l-2 4h12l-2-4z"/>
                    </svg>
                </div>
                <h3>Product Catalog</h3>
                <p>Browse products from SQL Server with real-time inventory status. Archived items are filtered automatically.</p>
            </div>

            <div class="feature-card card-cart">
                <div class="card-icon-wrap icon-cart">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#0891b2" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6"/>
                    </svg>
                </div>
                <h3>Cart &amp; Checkout</h3>
                <p>Session-based cart with atomic checkout — Order and OrderItems are written in a single transaction, guaranteed consistent.</p>
            </div>

            <div class="feature-card card-orders">
                <div class="card-icon-wrap icon-orders">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                    </svg>
                </div>
                <h3>Order History</h3>
                <p>Full audit trail per user. Price snapshots are preserved at order time so history is immutable even if catalog prices change.</p>
            </div>
        </div>
    </section>

</div>
